# ── Красивые адреса ─────────────────────────────────────────────────────────
RewriteEngine On

# Если сайт лежит в подпапке, раскомментируйте и укажите её:
# RewriteBase /tce-php/

# ── Редиректы со старых адресов (переезд в корень tce.az) ───────────────────
# Стейджинг /yeni/... → корень
RewriteRule ^yeni(?:/(.*))?$ /$1 [R=301,L]

# Посты старого WordPress → страницы проектов
RewriteRule ^2026/06/01/villa-layih - [E=GOTO:/layihe/villa-layihe]
RewriteRule ^2025/03/03/the-glass-house - [E=GOTO:/layihe/the-glass-house]
RewriteRule ^2025/03/03/the-xs-luxury-apartment - [E=GOTO:/layihe/the-xs-luxury-apartment]
RewriteRule ^2025/03/03/the-pool-house - [E=GOTO:/layihe/the-pool-house]
RewriteCond %{ENV:GOTO} !^$
RewriteRule ^ %{ENV:GOTO} [R=301,L]

# Остальные датированные записи и архивы WP → список проектов
RewriteRule ^20[0-9]{2}/[0-9]{2}(/|$) /layiheler [R=301,L]
RewriteRule ^(category|tag|author|feed|comments)(/|$) / [R=301,L]

# Служебные адреса WordPress больше не существуют
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes)(/|$) / [R=301,L]

# Служебные каталоги недоступны из браузера
RewriteRule ^(storage|config|tools|\.git)(/|$) - [F,L]

# Существующие файлы и папки отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Остальное — во фронт-контроллер
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# ── Убираем index.php из адреса ─────────────────────────────────────────────
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── Кодировка ───────────────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── Запрет листинга каталогов ───────────────────────────────────────────────
Options -Indexes

# ── Заголовки безопасности ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Кеш статики ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg          "access plus 6 months"
  ExpiresByType image/png           "access plus 6 months"
  ExpiresByType image/webp          "access plus 6 months"
  ExpiresByType image/svg+xml       "access plus 6 months"
  ExpiresByType font/woff2          "access plus 1 year"
</IfModule>

# ── Сжатие ──────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ── Закрываем служебные файлы ───────────────────────────────────────────────
<FilesMatch "\.(log|md|json|ya?ml|lock|sh|bak|sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.(git|env)">
  Require all denied
</FilesMatch>
